  componentName "IT Module: Sensor (passive Si)"
  service false
  scaleOnSensor 0
  Element {
    elementName Si
    quantity 0.1655 // 0.175 g from the lab measurement, minus the dead-area ring
    unit g
    targetVolume 3
  }
